# ==============================================================================
# Faculty Career Advancement & Publication Summary Generator - Environment Template
# ==============================================================================

# Backend Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local, Atlas, or auto-fallback to Memory Server)
MONGODB_URI=mongodb://127.0.0.1:27017/faculty_advancement

# JWT Authentication Secret & Token Expiration
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRE=7d

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Cookie Session Security
COOKIE_SECRET=your_secure_cookie_secret_here

# SMTP Mailer Settings (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Faculty Career Portal <no-reply@institution.edu>"

# Scholarly Metadata APIs (Crossref Polite Pool)
CROSSREF_MAILTO=research.office@institution.edu
